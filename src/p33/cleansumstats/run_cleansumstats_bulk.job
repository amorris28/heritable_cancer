#!/bin/bash
#SBATCH --job-name=SUMSTAT
#SBATCH --account=p33
#SBATCH --time=4:00:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8000M
#SBATCH --cpus-per-task=16
#SBATCH --array=1-4 # user input depending on the number of meta files in the trait list

module purge
test $SCRATCH && module load singularity/3.7.3 
source /cluster/bin/jobsetup
set -o errexit

# User input (list of meta files (.yaml), output directory and TSD project)
export LIST=traitlist.txt
export OUT_DIR=/ess/p33/cluster/users/andrewmo/sumstats
export WORK_DIR=/ess/p33/cluster/users/andrewmo/scratch
export TSD_PROJ=p33 # p697 or p33

# Path and variable definition
NUM=$SLURM_ARRAY_TASK_ID && echo ${NUM}
export META_YAML=$(sed "${NUM}q;d" ${LIST}) && echo Input meta file: "${META_YAML}" # get trait from list
#export WORK_DIR=${SCRATCH}/out && mkdir -p ${WORK_DIR} && echo Temporary working directory: "${WORK_DIR}"

# Get script location
IFS=' ' read -r SCRIPT_DIR _ <<< $(scontrol show job "$SLURM_JOB_ID" | awk -F= '/Command=/{print $2}')
SCRIPT_DIR=$(dirname ${SCRIPT_DIR}) && echo Script location: "$SCRIPT_DIR"

# Shell script call
bash ${SCRIPT_DIR}/run_cleansumstats.sh ${META_YAML} ${OUT_DIR} ${WORK_DIR} ${TSD_PROJ}
# bash ${SCRIPT_DIR}/run_cleansumstats_bim.sh ${META_YAML} ${OUT_DIR} ${WORK_DIR} ${TSD_PROJ}

