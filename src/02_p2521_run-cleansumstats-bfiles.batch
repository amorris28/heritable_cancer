#!/bin/bash
#SBATCH --job-name=CLEANSUMSTATS
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p2521_tsd
#SBATCH --time=04:00:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8G
#SBATCH --cpus-per-task=16

# User input
export BFILE=/ess/p2521/data/durable/HuskMent/genotypes/imputed/v240619/husk_all.autosomes.v240619.plink1
export OUT_DIR=${SLURM_SUBMIT_DIR}/data/interim
export WORK_DIR=${SLURM_SUBMIT_DIR}/scratch
export TSD_PROJ=p2521
export COMORMENT=/ess/p2521/cluster/users/espehage/github/comorment/containers/containers/1.9.0
export CLEANSUMSTATS=/ess/p2521/cluster/users/p2521-andrewmo/cleansumstats_v1.7.0
export SCRIPT_DIR=/ess/p2521/cluster/users/p2521-andrewmo/JF

# Shell script call
bash ${SCRIPT_DIR}/run_cleansumstats_bim.sh ${BFILE} ${OUT_DIR} ${WORK_DIR} ${TSD_PROJ} ${COMORMENT} ${CLEANSUMSTATS}


