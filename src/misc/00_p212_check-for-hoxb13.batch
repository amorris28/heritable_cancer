#!/bin/bash
#SBATCH --job-name=hoxb13
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=1:00:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8000M
#SBATCH --cpus-per-task=1

export PLINK="singularity exec --bind /ess/p212:/ess/p212 --home $PWD $COMORMENT/containers/singularity/gwas.sif plink"
export BFILE=/ess/p212/cluster/NORGENE/impute5/PLINK_fmt/bim_backup/ALL.filt.chr17
export OUT_DIR=data/processed

$PLINK --bfile $BFILE --extract data/raw/rs138213197.txt --recode vcf --out ${OUT_DIR}/rs138213197