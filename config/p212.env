# Cohort-specific paths/params for p212 (NFCS/MoBA cohort, TSD project p212, GRCh37 imputed BIM)
# Sourced by scripts/*.sh — mirrors what used to live in the `p212` profile of nextflow.config
CLUSTER=p212
BUILD=37
BIM_TEMPLATE='/ess/p212/cluster/moba_qc_imputation/BA/release6/chr[0-9]*.imputed.bim'
VCF_TEMPLATE=
# Directory containing the genotype files above — must be --bind-mounted into
# singularity explicitly, since it lives outside the repo (auto CWD-bind won't reach it).
GENOTYPE_DIR=/ess/p212/cluster/moba_qc_imputation/BA/release6
PSAM_FLAG='--psam /ess/p212/cluster/moba_qc_imputation/BA/release6/chr@.ichunk_merged.fam'
PREPROCESS_SCRIPT=src/p212_metadata.R
HAS_HOXB13=1
HAS_WGS=1

PYTHON3_IMAGE=/cluster/projects/p212/github/comorment/containers/singularity/python3.sif
GWAS_IMAGE=/cluster/projects/p212/github/comorment/containers/singularity/gwas.sif

SLURM_ACCOUNT=p212
SLURM_MEM_PER_CPU=7792M
SLURM_TIME=04:00:00

# Bind mounts needed for preprocess_metadata's hardcoded absolute reads
BIND_PATHS=/ess/p212/home/p212-andrewmo/FW_Poly_tables,/ess/p212/data/durable/brca2_cancer_registry,/ess/p212/home/p212-andrewmo/heritable_cancer/data/raw

# Genotype bed file prefix (PCA, relatedness)
BED_FILE=/ess/p212/cluster/moba_qc_imputation/BA/release6/moba_imputed_all
