#!/bin/bash
#SBATCH --job-name=model-phs
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=00:05:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8000M
#SBATCH --cpus-per-task=1
#SBATCH --array=6

module load R/4.4.2-gfbf-2024a

export INTERIM_DIR=data/interim
export PROCESSED_DIR=data/processed
export MODELLIST=$PROCESSED_DIR/sumstats_basenames
NUM=$SLURM_ARRAY_TASK_ID && echo ${NUM}
export MODEL=$(sed "${NUM}q;d" ${MODELLIST}) && echo Input sumstats model: "${MODEL}" # get model from list
#export PHS=$(sed "${NUM}q;d" ${PHSLIST}) # get model from list
export COMORMENT=/cluster/projects/p212/github/comorment
export RSCRIPT="singularity exec --bind /ess/p212:/ess/p212 --home $PWD:/home $COMORMENT/containers/singularity/r.sif Rscript"
export TSD_PROJ=p212

Rscript src/05_fit-models-plot-figures.R ${PROCESSED_DIR}/${MODEL}_phs ${PROCESSED_DIR}/heritable_cancer_phenotypes.tsv FALSE $TSD_PROJ
Rscript src/05_fit-models-plot-figures_incidence-rate.R ${PROCESSED_DIR}/${MODEL}_phs ${PROCESSED_DIR}/heritable_cancer_phenotypes.tsv FALSE $TSD_PROJ
