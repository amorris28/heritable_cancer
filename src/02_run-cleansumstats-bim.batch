#!/bin/bash
#SBATCH --job-name=SUMSTAT
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=4:00:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8000M
#SBATCH --cpus-per-task=16
#SBATCH --array=1 # user input depending on the number of meta files in the trait list

module purge
test $SCRATCH #&& module load singularity/3.7.3 
source /cluster/bin/jobsetup
set -o errexit

# User input (list of meta files (.yaml), output directory and TSD project)
export LIST=${SLURM_SUBMIT_DIR}/data/raw/bimlist.txt
export OUT_DIR=${SLURM_SUBMIT_DIR}/data/interim
export WORK_DIR=${SLURM_SUBMIT_DIR}/scratch
export TSD_PROJ=p212 # p697 or p33 or p212
export COMORMENT=/ess/p212/cluster/github/comorment
export CLEANSUMSTATS=/ess/p212/cluster/projects/cleansumstats_v1.7.0
export SCRIPT_DIR=/ess/p212/home/p212-andrewmo/JF

# Path and variable definition
NUM=$SLURM_ARRAY_TASK_ID && echo ${NUM}
export META_YAML=${SLURM_SUBMIT_DIR}/$(sed "${NUM}q;d" ${LIST}) && echo Input meta file: "${META_YAML}" # get trait from list
#export WORK_DIR=${SCRATCH}/out && mkdir -p ${WORK_DIR} && echo Temporary working directory: "${WORK_DIR}"

# Get script location
# IFS=' ' read -r SCRIPT_DIR _ <<< $(scontrol show job "$SLURM_JOB_ID" | awk -F= '/Command=/{print $2}')
# SCRIPT_DIR=$(dirname ${SCRIPT_DIR}) && echo Script location: "$SCRIPT_DIR"

# Shell script call
#bash ${SCRIPT_DIR}/run_cleansumstats.sh ${META_YAML} ${OUT_DIR} ${WORK_DIR} ${TSD_PROJ}
bash ${SCRIPT_DIR}/run_cleansumstats_bim.sh ${META_YAML} ${OUT_DIR} ${WORK_DIR} ${TSD_PROJ}

