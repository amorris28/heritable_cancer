params {
    phs_file = 'data/external/01_geneticScore.finalModel.snplist.xlsx'
}
profiles {
    local {
        params {
	    cluster_name = 'local'
            bim_template = '/Users/andrewmorris/Projects/heritable_cancer/data/external/plink_example/chr[0-9]*.bim'
    	    build = '38'
    	    python3_image = 'ghcr.io/comorment/python3'
    	    gwas_image = 'ghcr.io/comorment/gwas'
    	    r_image = 'ghcr.io/comorment/r'
        }

        docker {
            enabled = true
            runOptions = "--platform linux/amd64"
        }
        process {
	    withName: harmonize_phs {
	        container = params.python3_image
	        maxForks 4
	    }
	}
    }

    p212 {
        params {
	    cluster_name = 'p212'
            bim_template = '/ess/p212/cluster/moba_qc_imputation/BA/release6/chr[0-9]*.imputed.bim'
    	    build = '37'
    	    python3_image = '/cluster/projects/p212/github/comorment/containers/singularity/python3.sif'
    	    gwas_image = '/cluster/projects/p212/github/comorment/containers/singularity/gwas.sif'
    	    r_image = '/cluster/projects/p212/github/comorment/containers/singularity/r.sif'
        }

        singularity {
	    enabled = true
	}
        process {
	    withName: harmonize_phs {
	        executor = 'local'
	        container = params.python3_image
	        // executor = 'slurm'
	        // clusterOptions = '--account=p212_tsd --mem-per-cpu=1G --time=00:10:00'
	    }
	    
	    withName: merge_phs_outputs {
	        executor = 'local'
	    }
	}
    }

    p2521 {
        params {
	    cluster_name = 'p2521'
            bim_template = '/different/path/clusterB/chr{chri}.bim'
    	    build = '38'
    	    python3_image = '/cluster/projects/p212/github/comorment/containers/singularity/python3.sif'
    	    gwas_image = '/cluster/projects/p212/github/comorment/containers/singularity/gwas.sif'
    	    r_image = '/cluster/projects/p212/github/comorment/containers/singularity/r.sif'
        }

        singularity {
	    enabled = true
	}
        process {
	    container = params.image
	}
    }
}
