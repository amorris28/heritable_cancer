params {
    harmonize_script = 'src/harmonize_phs.py'
    analysis_script = 'src/fit-models-plot-figures.R'
    incidence_script = 'src/fit-models-plot-figures-incidence-rate.R'
    wgs_script = 'src/fit-models-plot-figures-wgs.R'
    figures_script = 'src/make_figures_and_tables.R'
    phs_file = 'data/external/01_geneticScore.finalModel.snplist.xlsx'
    asir_file = 'data/external/ASIRs_per100k_Huynh-Le_2020.xlsx'
    r_config = 'src/config.R'
    r_functions = 'src/functions.R'
    interim_dir = 'data/interim'
    processed_dir = 'data/processed'
    public_dir = 'data/public'
    figures_dir = 'manuscript/figures_and_tables'
    manuscript_dir = 'manuscript'
    manuscript_file = 'manuscript/manuscript.qmd'
    reference_docx = 'manuscript/reference.docx'
    bibtex_file = 'manuscript/references.bib'
    extensions_dir = 'manuscript/_extensions'
    bim_template = null
    vcf_template = null
}

profiles {
    local {
        params {
            cluster = 'local'
            bim_template = '/Users/andrewmorris/Projects/heritable_cancer/data/external/plink_example/chr[0-9]*.bim'
            build = '38'
    	    python3_image = 'ghcr.io/comorment/python3'
    	    gwas_image = 'ghcr.io/comorment/gwas'
    	    r_image = 'ghcr.io/comorment/r'
        }

        docker {
            enabled = true
            runOptions = "--platform linux/amd64"
        }
        process {
	        withName: harmonize_phs_by_chr {
	            maxForks = 4
	        }
	    }
    }

    p212 {
        params {
            cluster = 'p212'
            bim_template = '/ess/p212/cluster/moba_qc_imputation/BA/release6/chr[0-9]*.imputed.bim'
    	    build = '37'
            psam_flag = '--psam /ess/p212/cluster/moba_qc_imputation/BA/release6/chr@.ichunk_merged.fam'
	        preprocess_script = 'src/p212_metadata.R'
    	    python3_image = '/cluster/projects/p212/github/comorment/containers/singularity/python3.sif'
    	    gwas_image = '/cluster/projects/p212/github/comorment/containers/singularity/gwas.sif'
    	    //r_image = '/cluster/projects/p212/github/comorment/containers/singularity/r.sif'
    	    r_image = '/tsd/p212/home/p212-andrewmo/r.sif'
        }

        singularity {
	        enabled = true
	    }
        process {
	        withName: filter_bfiles {
	            clusterOptions = '--account=p212_tsd --mem-per-cpu=7792M --cpus-per-task=1 --time=04:00:00'
	        }
            withName: preprocess_metadata {
                containerOptions = '--bind /ess/p212/home/p212-andrewmo/FW_Poly_tables,/ess/p212/data/durable/brca2_cancer_registry,/ess/p212/home/p212-andrewmo/heritable_cancer/data/raw'
            }
	    
	    }
    }

    p2521 {
        params {
            cluster = 'p2521'
	        vcf_template = '/ess/p2521/data/durable/HuskMent/genotypes/imputed/v240619/vcf/husk_all.imputed.chr[1-9]*.vcf.gz'
    	    build = '38'
	        preprocess_script = 'src/p2521_metadata.R'
    	    python3_image = '/ess/p2521/home/p2521-andrewmo/comorment_1.9.0/python3.sif'
    	    gwas_image = '/ess/p2521/home/p2521-andrewmo/comorment_1.9.0/gwas.sif'
    	    r_image = '/ess/p2521/home/p2521-andrewmo/comorment_1.9.0/r.sif'
        }

        singularity {
	    enabled = true
	}
        process {
	        withName: vcf_to_bim {
	            container = params.gwas_image
	            executor = 'slurm'
	            clusterOptions = '--account=p2521_tsd --mem-per-cpu=2G --cpus-per-task=1 --time=04:00:00'
	        }
	        withName: filter_vcfs {
	            clusterOptions = '--account=p2521_tsd --mem-per-cpu=7792M --cpus-per-task=1 --time=04:00:00'
	        }
            withName: preprocess_metadata {
                containerOptions = '--bind /ess/p2521/data/durable/HuskMent/phenotypes'
            }
	    
	    }
    }
}


process {
    withName: filter_bfiles {
        executor = 'slurm'
        container = params.gwas_image
    }
	withName: filter_vcfs {
        executor = 'slurm'
        container = params.gwas_image
	}
}
