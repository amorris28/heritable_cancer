# Cohort-specific paths/params for p2521 (HUSK cohort, TSD project p2521, GRCh38 imputed PLINK1 bfile, v260302)
# Sourced by scripts/*.sh — mirrors what used to live in the `p2521` profile of nextflow.config
CLUSTER=p2521
BUILD=38
BIM_TEMPLATE='/ess/p2521/data/durable/HuskMent/genotypes/imputed/v260302/all.plink1.bim'
VCF_TEMPLATE=
# Directory containing the genotype files above — must be --bind-mounted into
# singularity explicitly, since it lives outside the repo (auto CWD-bind won't reach it).
GENOTYPE_DIR=/ess/p2521/data/durable/HuskMent/genotypes/imputed/v260302
PSAM_FLAG=
PREPROCESS_SCRIPT=src/p2521_metadata.R
HAS_HOXB13=0
HAS_WGS=0

PYTHON3_IMAGE=/ess/p2521/home/p2521-andrewmo/comorment_1.9.0/python3.sif
GWAS_IMAGE=/ess/p2521/home/p2521-andrewmo/comorment_1.9.0/gwas.sif

SLURM_ACCOUNT=p2521
SLURM_MEM_PER_CPU=7792M
SLURM_TIME=04:00:00

# Bind mounts needed for preprocess_metadata's hardcoded absolute reads
BIND_PATHS=/ess/p2521/data/durable/HuskMent/phenotypes

# Relatedness bed file
BED_FILE=/ess/p2521/data/durable/HuskMent/genotypes/imputed/v260302/all.plink1