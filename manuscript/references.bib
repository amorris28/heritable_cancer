}

@article{vassy2026,
  title = {Genomic Risk Model to Implement Precision Prostate Cancer Screening in Clinical Care: The {{ProGRESS}} Study},
  shorttitle = {Genomic Risk Model to Implement Precision Prostate Cancer Screening in Clinical Care},
  author = {Vassy, Jason L. and Dornisch, Anna M. and Karunamuni, Roshan and Gatzen, Michael and Kachulis, Christopher J. and Lennon, Niall J. and Brunette, Charles A. and Danowski, Morgan E. and Hauger, Richard L. and Garraway, Isla P. and Kibel, Adam S. and Lee, Kyung M. and Lynch, Julie A. and Maxwell, Kara N. and Ratner, Dmitry and Rose, Brent S. and Teerlink, Craig C. and Xu, George J. and Hofherr, Sean E. and Lafferty, Katherine A. and Larkin, Katie and Malolepsza, Edyta and Patterson, Candace J. and Toledo, Diana M. and Donovan, Jenny L. and Hamdy, Freddie C. and Martin, Richard M. and Neal, David E. and Turner, Emma L. and Andreassen, Ole A. and Dale, Anders M. and Mills, Ian G. and Abraham, Aswin and Batra, Jyotsna and Clements, Judith and Cussenot, Olivier and Cybulski, Cezary and Eeles, Rosalind A. and Fowke, Jay H. and Grindedal, Eli Marie and Gr{\"o}nberg, Henrik and Hamilton, Robert J. and Lim, Jasmine and Lu, Yong-Jie and MacInnis, Robert J. and Maier, Christiane and Mucci, Lorelei A. and Multigner, Luc and Neuhausen, Susan L. and Nielsen, Sune F. and Parent, Marie-{\'E}lise and Park, Jong Y. and Petrovics, Gyorgy and Plym, Anna and Razack, Azad and Rosenstein, Barry S. and Schleutker, Johanna and S{\o}rensen, Karina Dalsgaard and Townsend, Paul A. and Travis, Ruth C. and Vega, Ana and West, Catharine M. L. and Wiklund, Fredrik and Zheng, Wei and Seibert, Tyler M.},
  year = 2026,
  month = feb,
  journal = {Nature Cancer},
  volume = {7},
  number = {2},
  pages = {352--367},
  publisher = {Nature Publishing Group},
  issn = {2662-1347},
  doi = {10.1038/s43018-025-01103-0},
  urldate = {2026-04-13},
  abstract = {Precision healthcare aims to tailor disease prevention and early detection to individual risk. Prostate cancer screening may benefit from genomics-informed approaches. We developed and validated the P-CARE model, a prostate cancer risk prediction tool combining a polygenic score, family history and genetic ancestry, using data from over 585,000 male participants in the Million Veteran Program. The model was externally validated in diverse cohorts and implemented via a blended genome--exome assay for clinical use. Here we show that the P-CARE model identifies clinically meaningful gradients of prostate cancer risk among men, with higher scores associated with increased risk of any, metastatic and fatal prostate cancer. The model is now being used in a clinical trial of precision prostate cancer screening. This work demonstrates the potential for genomics-enabled health systems to improve prostate cancer screening and prevention in men. ClinicalTrials.gov registration: NCT05926102.},
