#!/bin/bash
#SBATCH --job-name=filter-bfiles
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=00:05:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8G
#SBATCH --cpus-per-task=1

module load R/4.4.2-gfbf-2024a

export INTERIM_DIR=data/interim
export OUT_DIR=data/processed
export BFILE=norgene_merged_cs.GRCh37
export BFILE_OUT=norgene_merged_cs
export WORK_DIR=scratch
export COMORMENT=/cluster/projects/p212/github/comorment
export PLINK="singularity exec --bind /ess/p212:/ess/p212 --home $PWD $COMORMENT/containers/singularity/gwas.sif plink"
export RSCRIPT="singularity exec --bind /ess/p212:/ess/p212 --home $PWD $COMORMENT/containers/singularity/r.sif Rscript"

$RSCRIPT src/03_p212_update-norgene-ids.R

$PLINK  --bfile ${INTERIM_DIR}/${BFILE} \
	--update-ids ${INTERIM_DIR}/update-ids-norgene.tsv \
	--make-bed \
	--out ${WORK_DIR}/${BFILE_OUT}

$PLINK	--bfile ${WORK_DIR}/${BFILE_OUT} \
	--keep ${OUT_DIR}/bfile_id_samples.txt \
	--extract ${INTERIM_DIR}/phs_rsids \
	--make-bed \
	--out ${OUT_DIR}/${BFILE_OUT}_filtered