#!/bin/bash
#SBATCH --job-name=phs
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=00:05:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8000M
#SBATCH --cpus-per-task=1
#SBATCH --array=1-5

module purge
test $SCRATCH && module load R/4.4.1-gfbf-2023b 
source /cluster/bin/jobsetup
set -o errexit

export INTERIM_DIR=data/interim
export PROCESSED_DIR=data/processed
export MODELLIST=$INTERIM_DIR/sumstats_basenames
NUM=$SLURM_ARRAY_TASK_ID && echo ${NUM}
export MODEL=$(sed "${NUM}q;d" ${MODELLIST}) && echo Input sumstats model: "${MODEL}" # get model from list
#export PHS=$(sed "${NUM}q;d" ${PHSLIST}) # get model from list
export COMORMENT=/cluster/projects/p212/comorment
export RSCRIPT="singularity exec --bind /ess/p212:/ess/p212 --home $PWD:/home $COMORMENT/containers/singularity/r.sif Rscript"

mkdir -p reports/figures

Rscript src/07_pca_calculate-phs.R ${PROCESSED_DIR}/${MODEL}.txt.gz $PROCESSED_DIR/familial_cancer_cs_PCa
Rscript src/phs_testing.R ${PROCESSED_DIR}/${MODEL}_phs ${PROCESSED_DIR}/familial_cancer_phenotypes.tsv TRUE

