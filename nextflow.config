params {
    phs_file = 'data/external/01_geneticScore.finalModel.snplist.xlsx'
    r_config = 'src/config.R'
    r_functions = 'src/functions.R'
}

profiles {
    local {
        params {
	    cluster_name = 'local'
            bim_template = '/Users/andrewmorris/Projects/heritable_cancer/data/external/plink_example/chr[0-9]*.bim'
    	    build = '38'
    	    python3_image = 'ghcr.io/comorment/python3'
    	    gwas_image = 'ghcr.io/comorment/gwas'
    	    r_image = 'ghcr.io/comorment/r'
        }

        docker {
            enabled = true
            runOptions = "--platform linux/amd64"
        }
        process {
	    withName: clean_phs {
	        maxForks 4
	    }
	}
    }

    p212 {
        params {
	    cluster_name = 'p212'
            bim_template = '/ess/p212/cluster/moba_qc_imputation/BA/release6/chr[0-9]*.imputed.bim'
    	    build = '37'
	    preprocess_script = 'src/p212_metadata.R'
    	    python3_image = '/cluster/projects/p212/github/comorment/containers/singularity/python3.sif'
    	    gwas_image = '/cluster/projects/p212/github/comorment/containers/singularity/gwas.sif'
    	    r_image = '/cluster/projects/p212/github/comorment/containers/singularity/r.sif'
        }

        singularity {
	    enabled = true
	}
        process {
	}
    }

    p2521 {
        params {
	    cluster_name = 'p2521'
	    vcf_file = '/ess/p2521/data/durable/HuskMent/genotypes/imputed/v240619/vcf/husk_all.imputed.chr[1-9]*.vcf.gz'
	    // bim_template = 'data/interim/husk_bfiles/husk_all.chr[1-9]*.bim'
    	    build = '38'

	    preprocess_script = 'src/p2521_metadata.R'

    	    python3_image = '/ess/p2521/cluster/users/espehage/github/comorment/containers/containers/1.9.0/python3.sif'
    	    gwas_image = '/ess/p2521/cluster/users/espehage/github/comorment/containers/containers/1.9.0/gwas.sif'
    	    r_image = '/ess/p2521/cluster/users/espehage/github/comorment/containers/containers/1.9.0/r.sif'
        }

        singularity {
	    enabled = true
	}
        process {
	    withName: vcf_to_bim {
	        container = params.gwas_image
	        executor = 'slurm'
	        clusterOptions = '--account=p2521_tsd --mem-per-cpu=2G --time=04:00:00'
	    }

	    
	}
    }
}

process {
    withName: clean_phs {
        executor = 'local'
        container = params.python3_image
    }
    withName: merge_phs_outputs {
        executor = 'local'
    }
    withName: preprocess_metadata {
        executor = 'local'
        container = params.r_image
    }
}
