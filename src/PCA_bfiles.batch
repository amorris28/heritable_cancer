#!/bin/bash
#SBATCH --job-name=bfiles
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=00:10:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=10G
#SBATCH --cpus-per-task=1

export BFILE=/cluster/projects/p212/antenor_pipeline/antegenes_imputed_allchr-temporary
export INTERIM_DIR=data/interim
export OUT_DIR=data/processed
export BFILE_OUT=familial_cancer_cs
export WORK_DIR=scratch
export COMORMENT=/cluster/projects/p212/comorment
export PLINK="singularity exec --bind /ess/p212:/ess/p212 --home $PWD:/home $COMORMENT/containers/singularity/gwas.sif plink"
export PLINK2="singularity exec --bind /ess/p212:/ess/p212 --home $PWD:/home $COMORMENT/containers/singularity/gwas.sif plink2"
export RSCRIPT="singularity exec --bind /ess/p212:/ess/p212 --home $PWD:/home $COMORMENT/containers/singularity/r.sif Rscript"

######################################################
# Fix fam file IDs

$RSCRIPT src/PCA_update_ids_antegenes.R

$PLINK  --bed ${BFILE}.bed \
	--fam ${BFILE}.fam \
	--bim data/interim/bim_files/${BFILE_OUT}_tmp.bim \
	--update-ids data/interim/update-ids-antegenes.tsv \
	--make-bed \
	--out ${WORK_DIR}/${BFILE_OUT}_tmp

#####################################################
### Rotate Alleles in 1KG imputation
####################################################
## Fix split chromsome with --sort-vars
$PLINK2 --bfile ${WORK_DIR}/${BFILE_OUT}_tmp \
	--make-pgen \
	--sort-vars \
	--out ${WORK_DIR}/${BFILE_OUT}_tmp_sorted

# Rotate alleles
$PLINK2 --pfile ${WORK_DIR}/${BFILE_OUT}_tmp_sorted \
	--alt1-allele force data/interim/bim_files/forceALT_betan_${BFILE_OUT}.txt \
	--make-bed \
	--out ${INTERIM_DIR}/bfiles/${BFILE_OUT}

awk '{split($2,a,"_"); print $1 "\t" a[1] "\t" $3 "\t" $4 "\t" $5 "\t" $6}' ${INTERIM_DIR}/bfiles/${BFILE_OUT}.bim > ${INTERIM_DIR}/bfiles/${BFILE_OUT}.bim_tmp
mv ${INTERIM_DIR}/bfiles/${BFILE_OUT}.bim_tmp ${INTERIM_DIR}/bfiles/${BFILE_OUT}.bim

######################################################
# Filter cases and controls

$RSCRIPT src/PCA_identify_cases_controls.R

# Pull out model SNP RSIDs
while read VARIABLE;
do
  echo $VARIABLE
  zcat data/interim/sumstats/${VARIABLE}/${VARIABLE}.GRCh37.gz | awk '{ print $3 }' | tail -n +2 >> ${INTERIM_DIR}/phs_rsids
  cp data/interim/sumstats/${VARIABLE}/${VARIABLE}.GRCh37.gz data/processed/${VARIABLE}.txt.gz
done < ${INTERIM_DIR}/sumstats_basenames 

$PLINK	--bfile ${INTERIM_DIR}/bfiles/${BFILE_OUT} \
	--keep ${INTERIM_DIR}/bfile_id_samples.txt \
	--extract ${INTERIM_DIR}/phs_rsids \
	--make-bed \
	--out ${OUT_DIR}/${BFILE_OUT}_PCa

