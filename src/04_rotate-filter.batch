#!/bin/bash
#SBATCH --job-name=rotate
#SBATCH --output=logs/%x.%j.out
#SBATCH --error=logs/%x.%j.err
#SBATCH --account=p212_tsd
#SBATCH --time=1:00:00
#SBATCH --ntasks=1
#SBATCH --mem-per-cpu=8000M
#SBATCH --cpus-per-task=1

cat data/interim/moba_imputed_all_cs.GRCh37.rotate_alleles.sh | bash
export OUT_DIR=data/interim
export BFILE_OUT=moba_imputed_all_cs

