export RSCRIPT="singularity exec --bind /ess/p2521:/ess/p2521 --home $PWD $COMORMENT/containers/containers/1.9.0/r.sif Rscript"

######################################################
# Identify cases and controls, calculate age of censoring/diagnosis

$RSCRIPT src/p2521_01_preprocess-phenotypes.R

