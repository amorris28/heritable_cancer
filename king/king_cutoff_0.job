#!/bin/bash
#SBATCH --job-name=king_cutoff_0
#SBATCH --open-mode=truncate
#SBATCH --output=king/king_cutoff_0.txt
#SBATCH --error=king/king_cutoff_0.txt
#SBATCH --account=p212
#SBATCH --time=01:00:00
#SBATCH --cpus-per-task=64
#SBATCH --mem-per-cpu=4000  # memory (MB)
#SBATCH --partition=normal

# environment
set -euo pipefail
export GWASSIF=/cluster/projects/p212/github/comorment/containers/singularity/gwas.sif

# Bind directories
export APPTAINER_BIND=/ess:/ess

if [[ -n "${SCRATCH:-}" ]]; then
    export APPTAINER_BIND="${APPTAINER_BIND},${SCRATCH}:/SCRATCH"
fi

# executables
export PLINK2="apptainer exec --home=$PWD:/home $GWASSIF plink2"

KING_BFILE="${KING_BFILE:-/ess/p212/cluster/moba_qc_imputation/BA/release6/moba_imputed_all}"
KING_RESULTS="${KING_RESULTS:-${SLURM_SUBMIT_DIR:-$PWD}/data/interim/relatedness/p212}"
mkdir -p "$KING_RESULTS"

$PLINK2 --bfile "$KING_BFILE" \
    --king-cutoff "$KING_RESULTS/all_chr" 0.353553 \
    --out "$KING_RESULTS/all_chr.cutoff_0deg" \
    --threads 64 \
    --memory 256000
