params {
    phs_file = 'data/external/01_geneticScore.finalModel.snplist.xlsx'
}
profiles {
    local {
        params {
	    cluster_name = 'local'
            bim_template = '/Users/andrewmorris/Projects/heritable_cancer/data/external/plink_example/chr[0-9]*.bim'
    	    build = '38'
    	    image = 'ghcr.io/comorment/python3'
        }

        docker {
            enabled = true
            runOptions = "--platform linux/amd64"
        }
        process {
	    container = params.image
	}
    }

    p212 {
        params {
	    cluster_name = 'p212'
            bim_template = '/path/to/clusterA/plink_data/chr{chri}.bim'
    	    build = '37'
    	    image = 'ghcr.io/comorment/python3'
        }

        singularity {
	    enabled = true
	}
        process {
	    container = params.image
	}
    }

    p2521 {
        params {
	    cluster_name = 'p2521'
            bim_template = '/different/path/clusterB/chr{chri}.bim'
    	    build = '38'
    	    image = 'ghcr.io/comorment/python3'
        }

        singularity {
	    enabled = true
	}
        process {
	    container = params.image
	}
    }
}
